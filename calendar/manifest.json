{
  "id": "calendar",
  "name": "Calendar",
  "version": "0.1.0",
  "minNoctaliaVersion": "4.5.0",
  "author": "rrodriguez06",
  "license": "MIT",
  "description": "Gestionnaire d'emploi du temps : fusionne tes calendriers Google (pro + perso), vues mois/semaine/jour, création/édition/suppression d'événements et synchronisation live. S'appuie sur le backend `calsync` (CLI + daemon).",
  "tags": ["Bar", "Panel", "ControlCenter", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "launcherProvider": "LauncherProvider.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "binPath": "calsync",
      "defaultView": "month",
      "weekStartsOn": 1,
      "dayStartHour": 7,
      "dayEndHour": 22,
      "ensureDaemon": true,
      "syncOnOpen": true,
      "calendars": []
    }
  }
}
