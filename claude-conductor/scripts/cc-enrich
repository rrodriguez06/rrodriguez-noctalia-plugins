#!/bin/sh
# Claude Conductor — enrichissement d'une session depuis son transcript .jsonl.
# Usage : cc-enrich <cwd> <sessionId>
# Dérive le transcript : ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/<enc(cwd)>/<sessionId>.jsonl
#   où enc(cwd) = cwd avec tout caractère non [a-zA-Z0-9] remplacé par '-'.
# Émet : {title, gitBranch, model, lastType, lastTs, lastText}
#   title = aiTitle généré ; lastText = dernier message assistant (texte concaténé).

cwd="$1"; sid="$2"
command -v jq >/dev/null 2>&1 || { printf '{}\n'; exit 0; }
[ -n "$cwd" ] && [ -n "$sid" ] || { printf '{}\n'; exit 0; }

enc=$(printf '%s' "$cwd" | sed 's/[^a-zA-Z0-9]/-/g')
tp="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$enc/$sid.jsonl"
[ -f "$tp" ] || { printf '{}\n'; exit 0; }

# On ne lit que la fin du fichier (perf) ; chaque ligne est un JSON. `fromjson?` ignore
# une éventuelle 1re ligne tronquée par le découpage en octets.
tail -c 262144 "$tp" 2>/dev/null | jq -R 'fromjson?' 2>/dev/null | jq -s '
  {
    title:     ( [ .[] | select(.type=="ai-title") | (.aiTitle // .title) ] | last // "" ),
    gitBranch: ( [ .[] | .gitBranch // empty ] | last // "" ),
    model:     ( [ .[] | .message.model // empty ] | last // "" ),
    lastType:  ( .[-1].type // "" ),
    lastTs:    ( [ .[] | .timestamp // empty ] | last // "" ),
    lastText:  ( [ .[] | select(.type=="assistant") | .message.content
                   | if   type=="array"  then ( .[] | select(.type=="text") | .text )
                     elif type=="string" then .
                     else empty end ]
                 | map(select(. != null and . != "")) | last // "" )
  }
' 2>/dev/null || printf '{}\n'
exit 0
