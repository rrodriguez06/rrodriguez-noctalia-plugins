#!/bin/sh
# Claude Conductor — installe / désinstalle les hooks Claude Code qui alimentent le plugin.
# Usage :
#   cc-hooks-install            installe (idempotent)
#   cc-hooks-install --uninstall  retire UNIQUEMENT nos entrées
#   cc-hooks-install --status     imprime "installed" ou "absent" (sans effet de bord)
# Édite ~/.claude/settings.json en préservant le reste ; crée une sauvegarde .bak.

DIR=$(dirname -- "$0")
DIR=$(cd -- "$DIR" && pwd -P)
HOOK="$DIR/cc-hook"
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
MARK="claude-conductor/scripts/cc-hook"   # signature pour reconnaître nos entrées (sans '/' initial :
                                          # l'UI Noctalia installe dans <hash>:claude-conductor)

command -v jq >/dev/null 2>&1 || { echo "jq introuvable" >&2; exit 2; }

# ── status : aucun effet de bord ────────────────────────────────────────────
if [ "$1" = "--status" ]; then
  if [ -f "$SETTINGS" ] && grep -q "$MARK" "$SETTINGS" 2>/dev/null; then
    echo installed
  else
    echo absent
  fi
  exit 0
fi

[ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
cp -f "$SETTINGS" "$SETTINGS.bak"
tmp="$SETTINGS.cc.tmp"

# ── désinstallation ──────────────────────────────────────────────────────────
if [ "$1" = "--uninstall" ]; then
  jq --arg mark "$MARK" '
    def clean(ev):
      if (.hooks[ev]?) then
        .hooks[ev] |= ( map( .hooks |= map(select((.command // "") | contains($mark) | not)) )
                        | map(select((.hooks // []) | length > 0)) )
        | (if (.hooks[ev] | length) == 0 then del(.hooks[ev]) else . end)
      else . end;
    clean("SessionStart") | clean("UserPromptSubmit") | clean("Notification")
    | clean("Stop") | clean("SessionEnd")
    | (if (.hooks? // {}) == {} then del(.hooks) else . end)
  ' "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "Hooks Claude Conductor désinstallés."
  exit 0
fi

# ── installation (idempotente : on purge nos anciennes entrées puis on rajoute) ─
jq --arg hook "$HOOK" --arg mark "$MARK" '
  def strip(ev):
    if (.hooks[ev]?) then
      .hooks[ev] |= ( map( .hooks |= map(select((.command // "") | contains($mark) | not)) )
                      | map(select((.hooks // []) | length > 0)) )
    else . end;
  def add(ev; state):
    .hooks = (.hooks // {})
    | .hooks[ev] = ( (.hooks[ev] // [])
                     + [ { "hooks": [ { "type": "command", "command": ($hook + " " + state) } ] } ] );
  strip("SessionStart") | strip("UserPromptSubmit") | strip("Notification") | strip("Stop") | strip("SessionEnd")
  | add("SessionStart"; "start")
  | add("UserPromptSubmit"; "running")
  | add("Notification"; "waiting")
  | add("Stop"; "idle")
  | add("SessionEnd"; "end")
' "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
echo "Hooks Claude Conductor installés."
exit 0
