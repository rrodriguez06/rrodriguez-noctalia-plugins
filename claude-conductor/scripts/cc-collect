#!/bin/sh
# Claude Conductor — collecteur bootstrap + liveness.
# Émet un tableau JSON des sessions Claude Code VIVANTES, depuis ~/.claude/sessions/*.json.
# Chaque enregistrement : {sessionId, pid, cwd, entrypoint, startedAt, kind, alive:true}.
# Sert au démarrage (sessions nées avant le plugin) et au GC (retrait des process morts).

dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions"
command -v jq >/dev/null 2>&1 || { printf '[]\n'; exit 0; }
[ -d "$dir" ] || { printf '[]\n'; exit 0; }

first=1
printf '['
for f in "$dir"/*.json; do
  [ -e "$f" ] || continue
  pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
  [ -n "$pid" ] || continue
  [ -d "/proc/$pid" ] || continue          # process mort → on ignore
  rec=$(jq -c '{sessionId: .sessionId, pid: .pid, cwd: .cwd, entrypoint: .entrypoint, startedAt: .startedAt, kind: .kind, alive: true}' "$f" 2>/dev/null)
  [ -n "$rec" ] || continue
  if [ $first -eq 1 ]; then first=0; else printf ','; fi
  printf '%s' "$rec"
done
printf ']\n'
exit 0
