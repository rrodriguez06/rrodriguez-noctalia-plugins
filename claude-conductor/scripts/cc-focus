#!/bin/sh
# Claude Conductor — focus la fenêtre Hyprland qui héberge une session Claude Code.
# Usage : cc-focus <pid> <cwd> <entrypoint>
# CLI    : remonte la chaîne /proc depuis <pid> jusqu'à un client hyprctl → focus.
# VS Code: résout d'abord le pid de l'éditeur via le lock ~/.claude/ide/*.lock (workspaceFolders),
#          puis même remontée. Fire-and-forget.

pid="$1"; cwd="$2"; entry="$3"
command -v hyprctl >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

clients=$(hyprctl clients -j 2>/dev/null)
[ -n "$clients" ] || exit 0

# VS Code : le pid de l'éditeur (dans le .lock) est directement un client hyprctl.
case "$entry" in
  *vscode*|*code*)
    idedir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/ide"
    if [ -d "$idedir" ] && [ -n "$cwd" ]; then
      for lk in "$idedir"/*.lock; do
        [ -e "$lk" ] || continue
        hit=$(jq -r --arg c "$cwd" 'select((.workspaceFolders // []) | index($c)) | .pid // empty' "$lk" 2>/dev/null)
        if [ -n "$hit" ]; then pid="$hit"; break; fi
      done
    fi
    ;;
esac

# Remontée de la chaîne des parents jusqu'à trouver un client hyprctl, puis focus par adresse.
p="$pid"
i=0
while [ -n "$p" ] && [ "$p" != "0" ] && [ "$p" != "1" ] && [ "$i" -lt 16 ]; do
  addr=$(printf '%s' "$clients" | jq -r --argjson pid "$p" 'map(select(.pid==$pid)) | (.[0].address // empty)' 2>/dev/null)
  if [ -n "$addr" ] && [ "$addr" != "null" ]; then
    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
    exit 0
  fi
  p=$(awk '/^PPid:/{print $2}' "/proc/$p/status" 2>/dev/null)
  i=$((i + 1))
done
exit 0
