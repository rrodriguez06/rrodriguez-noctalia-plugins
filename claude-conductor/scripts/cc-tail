#!/bin/sh
# Claude Conductor — suit un transcript Claude Code en clair dans un terminal (scrollback complet).
# Usage : cc-tail <cwd> <sessionId> [lines]
cwd="$1"; sid="$2"; n="${3:-200}"
command -v jq >/dev/null 2>&1 || { echo "jq introuvable"; exit 0; }
enc=$(printf '%s' "$cwd" | sed 's/[^a-zA-Z0-9]/-/g')
tp="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$enc/$sid.jsonl"
[ -f "$tp" ] || { echo "transcript introuvable : $tp"; exit 0; }

printf '\033[1m── %s · %s ──\033[0m\n' "$sid" "$cwd"
tail -n "$n" -f "$tp" 2>/dev/null | jq -r --unbuffered '
  if .type=="user" then
    "\n[36m▶ [0m" + ((.message.content) | if type=="array" then ([.[]|select(.type=="text")|.text]|join(" ")) elif type=="string" then . else "" end)
  elif .type=="assistant" then
    ((.message.content) | if type=="array" then ([.[] | if .type=="text" then .text elif .type=="tool_use" then "  [33m⚙ "+(.name//"tool")+"[0m" else empty end] | join("\n")) elif type=="string" then . else empty end)
  else empty end
'
