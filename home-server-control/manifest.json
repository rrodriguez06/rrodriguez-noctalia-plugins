{
  "id": "home-server-control",
  "name": "Home Server Control",
  "version": "0.3.2",
  "minNoctaliaVersion": "4.5.0",
  "author": "rrodriguez06",
  "license": "MIT",
  "description": "Monitore et pilote des services Docker (local/SSH) et Cloud Run (gcloud). Intégration optionnelle Home-Server-Runner (déploiements git-aware).",
  "tags": ["Bar", "Panel", "Launcher", "ControlCenter", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "launcherProvider": "LauncherProvider.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "hosts": [
        { "name": "local", "sshAlias": "", "hsrPath": "~/Home-Server-Runner", "readOnly": false, "mode": "auto" }
      ],
      "activeHostIndex": 0,
      "pollIntervalIdleMs": 45000,
      "pollIntervalOpenMs": 8000,
      "driftFetchOnOpen": true,
      "confirmDestructive": true,
      "showToasts": true,
      "notifyOnStateChange": true,
      "closePanelOnAction": false,
      "terminalCommand": "kitty -e",
      "logTailLines": 200
    }
  }
}
