{
  "id": "hypr-layout",
  "name": "Hypr Layout",
  "version": "0.5.2",
  "minNoctaliaVersion": "4.5.0",
  "author": "rrodriguez06",
  "license": "MIT",
  "description": "Sauvegarde et restaure des dispositions de fenetres Hyprland (via le CLI hypr-layout).",
  "tags": ["Bar", "Panel", "Launcher", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "launcherProvider": "LauncherProvider.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "confirmClean": true,
      "showToasts": true,
      "closePanelOnAction": false,
      "confirmDelete": true,
      "defaultLoadMode": "add",
      "springLoadDelay": 250,
      "colorizeAppIcons": false,
      "appIconColor": "primary"
    }
  }
}
